+                  border: Border.all(color: c.glassBorder),
+                ),
+                child: Icon(
+                  mode.enablesReactiveVisual
+                      ? Icons.graphic_eq_rounded
+                      : Icons.view_compact_alt_rounded,
+                  color: c.primary,
+                ),
+              ),
+              const SizedBox(width: 16),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Row(
+                      children: [
+                        Text(

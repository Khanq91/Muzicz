+                      style: GoogleFonts.outfit(
+                        fontSize: 12,
+                        color: c.textTertiary,
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+              AnimatedScale(
+                scale: isSelected ? 1 : 0,
+                duration: const Duration(milliseconds: 180),
+                curve: Curves.easeOutBack,
+                child: Icon(
+                  Icons.check_circle_rounded,
+                  color: c.primary,
+                  size: 22,

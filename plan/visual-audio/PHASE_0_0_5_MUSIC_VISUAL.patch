+            borderRadius: BorderRadius.circular(16),
+            border: Border.all(
+              color: isSelected ? c.primary : c.border,
+              width: isSelected ? 1.5 : 0.5,
+            ),
+          ),
+          child: Row(
+            children: [
+              Container(
+                width: 44,
+                height: 44,
+                decoration: BoxDecoration(
+                  color: c.glassBg,
